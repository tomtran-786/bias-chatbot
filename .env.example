# Copy to .env.local and fill in. .env*.local is gitignored.

# ---- Gemini ----
# Create a key at https://aistudio.google.com/apikey (no credit card required to
# start, but see the note on Search grounding below).
GEMINI_API_KEY=

# Pinned deliberately, for two reasons.
#
# First, availability: gemini-2.5-flash now returns 404 for newly created keys.
# Verify the pinned model still answers before each demo.
#
# Second, quota: free-tier limits differ enormously between models. Google does
# not publish the real figures in the docs — read them at
# https://aistudio.google.com/rate-limit
#
# The market lookup uses Grounding with Google Search, which has its OWN quota and
# is often zero on a free-tier key even when ordinary calls work. If the lookup
# fails with a 429 while the questions work, that is why: use a key from a project
# with billing enabled. `npm run spike` tells you which case you are in.
GEMINI_MODEL=gemini-3.6-flash

# ---- Parameters ----
# Which protocol document in protocols/ to load. Never edit a protocol that is
# already in use — copy it to protocol_v3.md and point this at the new file.
PROTOCOL_FILE=protocol_v2.md

# Hard cap on turns per appraisal, guarding the quota against one runaway
# conversation. Four questions and a verdict is the intended length.
MAX_TURNS=20
