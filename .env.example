# Copy to .env.local and fill in. .env*.local is gitignored.
#
# This app is meant to cost nothing and never ask for a card. Two settings keep it
# that way, and neither is in this file because both are in the services' dashboards:
#
#   1. The Gemini key must come from a project with NO billing account (AI Studio
#      shows it as the Free tier). Then running out of quota can only return an
#      error, never a charge.
#   2. Leave pay-as-you-go OFF on Tavily. On the free plan, running out of credits
#      returns an error (HTTP 432) and stops.
#
#   3. Leave DEEPSEEK_API_KEY blank unless you accept a prepaid balance (see the
#      DeepSeek section). With it blank the app has no backup model and stays free.
#
# DAILY_SEARCH_BUDGET / DAILY_MODEL_BUDGET below are only a second line of
# defence against a loop. They live in memory and reset when the server restarts,
# so they are not what keeps this free. The two settings above are.

# ---- Gemini (free tier) ----
# Create a key at https://aistudio.google.com/apikey — no credit card required.
# On the free tier, what is sent to Gemini, photos included, may be used by Google
# to improve its products; the intake screen says so.
GEMINI_API_KEY=

# Pinned deliberately: gemini-2.5-flash now returns 404 for newly created keys, and
# free-tier limits differ enormously between models. Verify the pinned model still
# answers before each demo, and read real limits at https://aistudio.google.com/rate-limit
GEMINI_MODEL=gemini-3.6-flash

# Other Gemini models to try, in order, when the pinned one is out of quota (429),
# overloaded (503) or does not exist for your key (404). Free-tier quota is counted
# PER MODEL, so the next model on the same key usually still has some. No new account
# and no card: it is the same key, the same free tier, and the models can see photos.
#   - unset: the default list below
#   - set but empty (GEMINI_FALLBACK_MODELS=): no chain, only GEMINI_MODEL
#   - names that do not exist for your key are skipped with a warning in the server log
# These changed often: gemini-2.5-* already 404 for new keys, and some models answer
# 429 (no free quota) or hang under load. Check what answers with `npm run models` if
# you add this, or read https://aistudio.google.com/rate-limit.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# ---- Tavily (web search for used listings) ----
# Sign up at https://tavily.com — the free "Researcher" plan gives 1,000 credits a
# month and needs no card. One basic search is 1 credit and an appraisal runs 2, so
# that is about 500 appraisals a month. Do NOT turn on pay-as-you-go.
TAVILY_API_KEY=

# ---- OpenRouter (optional FREE backup, tried before DeepSeek) ----
# Used only after every Gemini model above has refused (quota or overload). Blank
# means it is skipped.
#
# It costs nothing, and the code enforces that: ONLY free models are ever called, i.e.
# ids ending in ":free" and OpenRouter's own openrouter/free router. Any other id in
# OPENROUTER_MODELS is dropped, with a warning in the server log, before a request is
# built, so a key that has credits on it cannot be charged for a model named by mistake.
#
# Limits on free models: 20 requests a minute, and 50 a day if you have bought fewer
# than 10 credits (1,000 a day above that). One appraisal is about nine model calls,
# so the low cap is roughly five appraisals a day, and only after Gemini ran out.
#
# It reads text only (no photo is ever sent) and free models are run by third-party
# providers. OpenRouter's own prompt logging and "use of inputs" are off unless you
# turned them on, but its docs do not say what each free provider does with prompts.
# Some free models may not be served unless your account's privacy settings allow it
# (https://openrouter.ai/settings/privacy). The free list changes; models are tried in
# order, and one that is removed or busy is skipped.
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,openrouter/free

# ---- DeepSeek (optional backup model, the LAST resort) ----
# Used only after EVERY model in the Gemini chain above has refused AND OpenRouter (if
# set up) has failed too. Blank means it is skipped.
#
# This one is NOT free. DeepSeek is prepaid: costs come off a balance you top up
# (or a balance it grants; its docs do not promise one), and at zero the API answers
# 402 and stops, so nothing can be charged beyond what you put on the account. At the
# time of writing, deepseek-flash costs roughly 1-2 CNY per million input tokens and
# 4-8 CNY per million output tokens, so one appraisal is a small fraction of a cent.
# Check https://api-docs.deepseek.com/zh-cn/quick_start/pricing before relying on it.
#
# It reads text only: no photo is ever sent to it. Everything else in the
# conversation is, and goes to DeepSeek's servers; the intake screen says so.
# Create a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# ---- Parameters ----
# Which protocol document in protocols/ to load. Never edit a protocol that is
# already in use — copy it to protocol_v3.md and point this at the new file.
PROTOCOL_FILE=protocol_v2.md

# Hard cap on turns per appraisal, guarding the quota against one runaway
# conversation. Four questions and a verdict is the intended length.
MAX_TURNS=20

# Daily tripwires on outbound calls, counted in memory (see lib/budget.ts). One
# appraisal is 2 searches and 2 model calls; each chat turn is 1 model call.
DAILY_SEARCH_BUDGET=40
DAILY_MODEL_BUDGET=300
