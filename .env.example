# Copy to .env.local and fill in. .env*.local is gitignored.

# ---- Gemini ----
# Create a key at https://aistudio.google.com/apikey (no credit card required).
GEMINI_API_KEY=

# Pinned deliberately, for two reasons.
#
# First, availability: gemini-2.5-flash now returns 404 for newly created keys,
# and Google names gemini-3.6-flash as its replacement. Verify the pinned model
# still answers before each testing wave.
#
# Second, quota: free-tier limits differ enormously between models. The newest
# model (gemini-3.8-flash) carries roughly 20 requests/day, which one decision
# would exhaust on its own. Google does not publish the real figures in the
# real figures in the docs — read them at https://aistudio.google.com/rate-limit
GEMINI_MODEL=gemini-3.6-flash

# ---- Study parameters ----
# Which protocol document in protocols/ to load. Never edit a protocol that is
# already in use — copy it to protocol_v2.md and point this at the new file.
# protocol_v1.md is a placeholder instantiation on sunk cost; after the lottery
# draft, fill in protocols/_template.md and repoint this. See protocols/README.md.
PROTOCOL_FILE=protocol_v1.md

# Hard cap on turns per decision, guarding the daily free-tier quota against
# one runaway conversation.
MAX_TURNS=40
